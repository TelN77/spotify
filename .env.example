# Spotify Developer Dashboard (https://developer.spotify.com/dashboard) で
# アプリを作成して取得した値を設定してください
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Redirect URIは通常は未設定でOK(アクセス元のURLから自動で決まる)。
# ただし、実際に使うURLを全てDashboardのRedirect URIsに登録しておくこと。
#   - ホストがPCでログインする場合:  http://127.0.0.1:8888/callback
#   - ゲストがスマホから連携する場合: https://<トンネルのドメイン>/callback (HTTPS必須)
# 固定したい場合のみ以下を設定:
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# サーバーのポート
PORT=8888

# 曲の残りがこのミリ秒を切ったら次の曲をキューに投入する
QUEUE_LEAD_MS=20000

# 再生状態のポーリング間隔(ミリ秒)
POLL_INTERVAL_MS=3000
