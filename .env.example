# Spotify Developer Dashboard (https://developer.spotify.com/dashboard) で
# アプリを作成して取得した値を設定してください
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Dashboardに登録するRedirect URIと完全に一致させること
# (Spotifyの仕様上、httpは 127.0.0.1 のみ許可。localhostは不可)
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# サーバーのポート
PORT=8888

# 曲の残りがこのミリ秒を切ったら次の曲をキューに投入する
QUEUE_LEAD_MS=20000

# 再生状態のポーリング間隔(ミリ秒)
POLL_INTERVAL_MS=3000
